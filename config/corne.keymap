#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        lshift_caps: lshift_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPS>;
        };

        rgb_lower_lt: rgb_lower_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&lower_rgb>, <&kp>;
        };

        rgb_raise_lt: rgb_raise_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&raise_rgb>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>; // TAB + Q
            timeout-ms = <50>;
        };

        combo_caps_word {
            bindings = <&caps_word>;
            key-positions = <24 35>; // Left Shift + Right Shift
            timeout-ms = <75>;
            layers = <0>;
        };
    };

    macros {
        lower_rgb: lower_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press &mo 1>,
                <&macro_tap &rgb_ug RGB_COLOR_HSB(210, 100, 30)>,
                <&macro_pause_for_release>,
                <&macro_release &mo 1>,
                <&macro_tap &rgb_ug RGB_COLOR_HSB(0, 0, 30)>;
        };

        raise_rgb: raise_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press &mo 2>,
                <&macro_tap &rgb_ug RGB_COLOR_HSB(280, 100, 30)>,
                <&macro_pause_for_release>,
                <&macro_release &mo 2>,
                <&macro_tap &rgb_ug RGB_COLOR_HSB(0, 0, 30)>;
        };

        mouse_rgb: mouse_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_tap &tog 3>,
                <&macro_tap &rgb_ug RGB_COLOR_HSB(120, 100, 30)>;
        };

        base_rgb: base_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_tap &to 0>,
                <&macro_tap &rgb_ug RGB_COLOR_HSB(0, 0, 30)>;
        };

        cad: ctrl_alt_delete {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL &kp LALT>,
                <&macro_tap &kp DEL>,
                <&macro_release &kp LCTRL &kp LALT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | SHFT |
            //                    | GUI | SPC/LWR | ENT |   | DEL | SPC/RSE | ALT |
            // Combo: TAB + Q = ESC, both Shifts = Caps Word, double-tap left Shift = Caps Lock

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R          &kp T    &kp Y    &kp U          &kp I      &kp O    &kp P     &kp BACKSPACE
&kp LCTRL  &kp A  &kp S  &kp D     &kp F          &kp G    &kp H    &kp J          &kp K      &kp L    &kp SEMI  &kp SQT
&lshift_caps  &kp Z  &kp X  &kp C     &kp V          &kp B    &kp N    &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                            &kp LGUI  &rgb_lower_lt 0 SPACE  &kp RET  &kp DEL  &rgb_raise_lt 0 SPACE  &kp RALT
            >;
        };

        lower_layer {
            display-name = "Lower Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BT1 | BT2 | BT3 | BT4 | BT5 |BTCLR|   | HOME| LFT | DWN |  UP | RGT | END  |
            // | SHFT | RGB |RGBFX| OUT |     |     |   | PLAY| PRV | VDN | VUP | NXT | MUTE |
            //                    | GUI |     |     |   |     |      | ALT |

            bindings = <
&kp TAB     &kp N1           &kp N2        &kp N3           &kp N4        &kp N5             &kp N6      &kp N7      &kp N8       &kp N9      &kp N0     &kp BSPC
&bt BT_SEL 0  &bt BT_SEL 1     &bt BT_SEL 2  &bt BT_SEL 3     &bt BT_SEL 4  &bt BT_CLR        &kp HOME    &kp LEFT    &kp DOWN     &kp UP      &kp RIGHT  &kp END
&kp LSHFT   &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &out OUT_TOG  &trans  &trans  &kp C_PP    &kp C_PREV   &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT  &kp C_MUTE
                                           &kp LGUI         &trans        &trans             &trans      &trans      &kp RALT
            >;
        };

        raise_layer {
            display-name = "Raise Layer";

            // -----------------------------------------------------------------------------------------
            // | CAD  |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | DEL  |
            // | CTRL | OSG | OSA | OSC | OSS |MOUS |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     |     |   |     |      | ALT |
            // OSG/OSA/OSC/OSS = one-shot GUI/ALT/CTRL/SHIFT
            // CAD = Ctrl + Alt + Delete, MOUS = Toggle Mouse Layer + RGB color

            bindings = <
&cad       &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp DELETE
&kp LCTRL  &sk LGUI    &sk LALT    &sk LCTRL   &sk LSHFT   &mouse_rgb   &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans      &trans      &trans      &trans      &trans       &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                  &kp LGUI    &trans      &trans       &trans     &trans     &kp RALT
            >;
        };

        mouse_layer {
            display-name = "Mouse Layer";

            // -----------------------------------------------------------------------------------------
            // | BASE |     |     |     |     |     |   |     |     | MUP |     |     |      |
            // |      | OSG | OSA | OSC | OSS |     |   |     | MLFT| MDN | MUP | MRGT|      |
            // |      |     |     |     |     |     |   |     | SLFT| SDN | SUP | SRGT|      |
            //                    |     |     | LCLK|   | RCLK| MCLK |     |

            bindings = <
&base_rgb &trans    &trans    &trans    &trans    &trans    &trans    &trans          &mmv MOVE_UP    &trans        &trans           &trans
&trans   &sk LGUI  &sk LALT  &sk LCTRL &sk LSHFT &trans    &trans    &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans   &trans    &trans    &trans    &trans    &trans    &trans    &msc SCRL_LEFT &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                                      &trans    &trans    &mkp LCLK  &mkp RCLK     &mkp MCLK       &trans
            >;
        };
    };
};
