@@ -174,9 +249,9 @@ int display_event_handler(const zmk_event_t *eh) {
 
     switch (ev->state) {
     case ZMK_ACTIVITY_ACTIVE:
-        start_display_updates();
-        break;
     case ZMK_ACTIVITY_IDLE:
+        /* In optimal display policy, normal typing should not wake the OLED. */
+        break;
     case ZMK_ACTIVITY_SLEEP:
         stop_display_updates();
         break;
@@ -190,4 +265,42 @@ int display_event_handler(const zmk_event_t *eh) {
 ZMK_LISTENER(display, display_event_handler);
 ZMK_SUBSCRIPTION(display, zmk_activity_state_changed);
 
+static int display_policy_event_handler(const zmk_event_t *eh) {
+    const struct zmk_battery_state_changed *battery_ev = as_zmk_battery_state_changed(eh);
+    if (battery_ev != NULL) {
+        if (battery_ev->state_of_charge <= 20 && !low_battery_alerted) {
+            low_battery_alerted = true;
+            zmk_display_show_for_ms(15000);
+        } else if (battery_ev->state_of_charge > 25) {
+            low_battery_alerted = false;
+        }
+        return ZMK_EV_EVENT_BUBBLE;
+    }
+
+#if !IS_ENABLED(CONFIG_ZMK_SPLIT) || IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
+    if (as_zmk_endpoint_changed(eh) != NULL) {
+        zmk_display_show_for_ms(10000);
+        return ZMK_EV_EVENT_BUBBLE;
+    }
+
+#if defined(CONFIG_ZMK_BLE)
+    if (as_zmk_ble_active_profile_changed(eh) != NULL) {
+        zmk_display_show_for_ms(10000);
+        return ZMK_EV_EVENT_BUBBLE;
+    }
+#endif
+#endif
+
+    return ZMK_EV_EVENT_BUBBLE;
+}
+
+ZMK_LISTENER(display_policy, display_policy_event_handler);
+ZMK_SUBSCRIPTION(display_policy, zmk_battery_state_changed);
+#if !IS_ENABLED(CONFIG_ZMK_SPLIT) || IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
+ZMK_SUBSCRIPTION(display_policy, zmk_endpoint_changed);
+#if defined(CONFIG_ZMK_BLE)
+ZMK_SUBSCRIPTION(display_policy, zmk_ble_active_profile_changed);
+#endif
+#endif
+
 #endif /* IS_ENABLED(CONFIG_ZMK_DISPLAY_BLANK_ON_IDLE) */
