+/*
+ * Copyright (c) 2026 The ZMK Contributors
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#define DT_DRV_COMPAT zmk_behavior_display_power
+
+#include <zephyr/device.h>
+#include <zephyr/devicetree.h>
+#include <drivers/behavior.h>
+
+#include <zmk/display.h>
+
+#include <dt-bindings/zmk/display_power.h>
+
+#include <zephyr/logging/log.h>
+LOG_MODULE_DECLARE(zmk, CONFIG_ZMK_LOG_LEVEL);
+
+#if DT_HAS_COMPAT_STATUS_OKAY(DT_DRV_COMPAT)
+
+static int
+on_keymap_binding_convert_central_state_dependent_params(struct zmk_behavior_binding *binding,
+                                                         struct zmk_behavior_binding_event event) {
+    if (binding->param1 == DISPLAY_POWER_CYCLE_CMD) {
+        switch (zmk_display_power_get_mode()) {
+        case ZMK_DISPLAY_POWER_MODE_OPTIMAL:
+            binding->param1 = DISPLAY_POWER_ON_CMD;
+            break;
+        case ZMK_DISPLAY_POWER_MODE_ON:
+            binding->param1 = DISPLAY_POWER_OFF_CMD;
+            break;
+        case ZMK_DISPLAY_POWER_MODE_OFF:
+        default:
+            binding->param1 = DISPLAY_POWER_OPTIMAL_CMD;
+            break;
+        }
+    }
+
+    return 0;
+}
+
+static int on_keymap_binding_pressed(struct zmk_behavior_binding *binding,
+                                     struct zmk_behavior_binding_event event) {
+    switch (binding->param1) {
+    case DISPLAY_POWER_INFO_CMD:
+        zmk_display_show_for_ms(15000);
+        return ZMK_BEHAVIOR_OPAQUE;
+    case DISPLAY_POWER_CYCLE_CMD:
+        zmk_display_power_cycle_mode();
+        return ZMK_BEHAVIOR_OPAQUE;
+    case DISPLAY_POWER_OPTIMAL_CMD:
+        zmk_display_power_set_mode(ZMK_DISPLAY_POWER_MODE_OPTIMAL);
+        return ZMK_BEHAVIOR_OPAQUE;
+    case DISPLAY_POWER_ON_CMD:
+        zmk_display_power_set_mode(ZMK_DISPLAY_POWER_MODE_ON);
+        return ZMK_BEHAVIOR_OPAQUE;
+    case DISPLAY_POWER_OFF_CMD:
+        zmk_display_power_set_mode(ZMK_DISPLAY_POWER_MODE_OFF);
+        return ZMK_BEHAVIOR_OPAQUE;
+    default:
+        LOG_ERR("Unknown display power command: %d", binding->param1);
+        return -ENOTSUP;
+    }
+}
+
+static int on_keymap_binding_released(struct zmk_behavior_binding *binding,
+                                      struct zmk_behavior_binding_event event) {
+    return ZMK_BEHAVIOR_OPAQUE;
+}
+
+static const struct behavior_driver_api behavior_display_power_driver_api = {
+    .binding_convert_central_state_dependent_params =
+        on_keymap_binding_convert_central_state_dependent_params,
+    .binding_pressed = on_keymap_binding_pressed,
+    .binding_released = on_keymap_binding_released,
+    .locality = BEHAVIOR_LOCALITY_GLOBAL,
+};
+
+BEHAVIOR_DT_INST_DEFINE(0, NULL, NULL, NULL, NULL, POST_KERNEL, CONFIG_KERNEL_INIT_PRIORITY_DEFAULT,
+                        &behavior_display_power_driver_api);
+
+#endif /* DT_HAS_COMPAT_STATUS_OKAY(DT_DRV_COMPAT) */
