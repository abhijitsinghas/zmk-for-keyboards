@@ -190,4 +448,66 @@ int display_event_handler(const zmk_event_t *eh) {
 ZMK_LISTENER(display, display_event_handler);
 ZMK_SUBSCRIPTION(display, zmk_activity_state_changed);
 
+static int display_policy_event_handler(const zmk_event_t *eh) {
+#if IS_ENABLED(CONFIG_ZMK_BATTERY_REPORTING)
+    const struct zmk_battery_state_changed *battery_ev = as_zmk_battery_state_changed(eh);
+    if (battery_ev != NULL) {
+        uint8_t soc = battery_ev->state_of_charge;
+        char percentage[12];
+        snprintf(percentage, sizeof(percentage), "%u%%", soc);
+
+        if (soc <= 5 && !critical_battery_alerted) {
+            critical_battery_alerted = true;
+            snprintf(percentage, sizeof(percentage), "CRITICAL %u%%", soc);
+            zmk_display_notify_for_ms("!!! BATTERY !!!", percentage, 30000, true);
+        } else if (soc <= 10 && !extreme_battery_alerted) {
+            extreme_battery_alerted = true;
+            zmk_display_notify_for_ms("Extremely Low", percentage, 20000, false);
+        } else if (soc <= 20 && !low_battery_alerted) {
+            low_battery_alerted = true;
+            zmk_display_notify_for_ms("Battery Low", percentage, 15000, false);
+        }
+
+        if (soc > 25) {
+            low_battery_alerted = false;
+        }
+        if (soc > 15) {
+            extreme_battery_alerted = false;
+        }
+        if (soc > 8) {
+            critical_battery_alerted = false;
+        }
+
+        return ZMK_EV_EVENT_BUBBLE;
+    }
+#endif
+
+#if !IS_ENABLED(CONFIG_ZMK_SPLIT) || IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
+    if (display_power_mode == ZMK_DISPLAY_POWER_MODE_OPTIMAL && as_zmk_endpoint_changed(eh) != NULL) {
+        zmk_display_show_for_ms(10000);
+        return ZMK_EV_EVENT_BUBBLE;
+    }
+
+#if defined(CONFIG_ZMK_BLE)
+    if (display_power_mode == ZMK_DISPLAY_POWER_MODE_OPTIMAL && as_zmk_ble_active_profile_changed(eh) != NULL) {
+        zmk_display_show_for_ms(10000);
+        return ZMK_EV_EVENT_BUBBLE;
+    }
+#endif
+#endif
+
+    return ZMK_EV_EVENT_BUBBLE;
+}
+
+ZMK_LISTENER(display_policy, display_policy_event_handler);
+#if IS_ENABLED(CONFIG_ZMK_BATTERY_REPORTING)
+ZMK_SUBSCRIPTION(display_policy, zmk_battery_state_changed);
+#endif
+#if !IS_ENABLED(CONFIG_ZMK_SPLIT) || IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
+ZMK_SUBSCRIPTION(display_policy, zmk_endpoint_changed);
+#if defined(CONFIG_ZMK_BLE)
+ZMK_SUBSCRIPTION(display_policy, zmk_ble_active_profile_changed);
+#endif
+#endif
+
 #endif /* IS_ENABLED(CONFIG_ZMK_DISPLAY_BLANK_ON_IDLE) */
