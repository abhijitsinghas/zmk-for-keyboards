+void unblank_display_cb(struct k_work *work) { resume_display_updates(); }
+
+static void power_off_display_rail(void) {
+#if !IS_ENABLED(CONFIG_ARCH_POSIX)
+    k_timer_stop(&display_timer);
+#endif // !IS_ENABLED(CONFIG_ARCH_POSIX)
+
+    display_blanking_on(display);
+
+#if DT_HAS_CHOSEN(zmk_display_led)
+    led_off(display_led, display_led_idx);
+#endif
+
+    const struct device *ext_power = ext_power_device();
+    if (ext_power != NULL) {
+        ext_power_disable(ext_power);
+    }
+}
+
+static void physically_power_off_display_cb(struct k_work *work) {
+    if (display_power_mode != ZMK_DISPLAY_POWER_MODE_ON) {
+        power_off_display_rail();
+    }
+}
+
+K_WORK_DELAYABLE_DEFINE(physically_power_off_display_work, physically_power_off_display_cb);
+
+static void force_refresh_display_cb(struct k_work *work) {
+    if (!device_is_ready(display)) {
+        LOG_ERR("Failed to find display device");
+        return;
+    }
+
+    resume_display_updates();
+
+    if (screen != NULL) {
+        lv_obj_invalidate(screen);
+    }
+
+    lv_refr_now(NULL);
+    lv_task_handler();
+}
+
+K_WORK_DEFINE(force_refresh_display_work, force_refresh_display_cb);
+
+static void flash_notification_cb(struct k_work *work);
+static void clear_notification_cb(struct k_work *work);
+
+K_WORK_DELAYABLE_DEFINE(flash_notification_work, flash_notification_cb);
+K_WORK_DELAYABLE_DEFINE(clear_notification_work, clear_notification_cb);
+
+static void ensure_notification_label(void) {
+    if (screen == NULL || notification_screen != NULL) {
+        return;
+    }
+
+    notification_screen = lv_obj_create(NULL);
+    notification_label = lv_label_create(notification_screen);
+    lv_obj_set_style_text_align(notification_label, LV_TEXT_ALIGN_CENTER, LV_PART_MAIN);
+    lv_obj_set_style_text_font(notification_label, lv_theme_get_font_small(notification_screen),
+                               LV_PART_MAIN);
+    lv_label_set_text(notification_label, "");
+    lv_obj_align(notification_label, LV_ALIGN_CENTER, 0, 0);
+}
+
+static void flash_notification_cb(struct k_work *work) {
+    if (!notification_flash || notification_label == NULL) {
+        return;
+    }
+
+    notification_visible = !notification_visible;
+    if (notification_visible) {
+        lv_obj_clear_flag(notification_label, LV_OBJ_FLAG_HIDDEN);
+    } else {
+        lv_obj_add_flag(notification_label, LV_OBJ_FLAG_HIDDEN);
+    }
+
+    lv_task_handler();
+    k_work_reschedule_for_queue(zmk_display_work_q(), &flash_notification_work, K_MSEC(500));
+}
+
+static void clear_notification_cb(struct k_work *work) {
+    notification_flash = false;
+    k_work_cancel_delayable(&flash_notification_work);
+
+    if (screen != NULL) {
+        lv_scr_load(screen);
+        lv_obj_invalidate(screen);
+        lv_refr_now(NULL);
+        lv_task_handler();
+    }
+
+    if (display_power_mode != ZMK_DISPLAY_POWER_MODE_ON) {
+        power_off_display_rail();
+    }
+}
+
+static void show_notification_cb(struct k_work *work) {
+    const struct device *ext_power = ext_power_device();
+    if (ext_power != NULL) {
+        ext_power_enable(ext_power);
+        k_msleep(10);
+    }
+
+    force_refresh_display_cb(work);
+    ensure_notification_label();
+
+    if (notification_screen == NULL || notification_label == NULL) {
+        return;
+    }
+
+    k_work_cancel_delayable(&physically_power_off_display_work);
+    k_work_cancel_delayable(&clear_notification_work);
+    k_work_cancel_delayable(&flash_notification_work);
+
+    lv_label_set_text(notification_label, notification_text);
+    lv_obj_align(notification_label, LV_ALIGN_CENTER, 0, 0);
+    notification_visible = true;
+    lv_obj_clear_flag(notification_label, LV_OBJ_FLAG_HIDDEN);
+    lv_scr_load(notification_screen);
+    lv_obj_invalidate(notification_screen);
+    lv_refr_now(NULL);
+    lv_task_handler();
+
+    if (notification_flash) {
+        k_work_reschedule_for_queue(zmk_display_work_q(), &flash_notification_work, K_MSEC(500));
+    }
+
+    k_work_reschedule_for_queue(zmk_display_work_q(), &clear_notification_work,
+                                K_MSEC(notification_timeout_ms));
+}
+
+K_WORK_DEFINE(show_notification_work, show_notification_cb);
+
+static void show_display_for_cb(struct k_work *work) {
+    if (display_power_mode == ZMK_DISPLAY_POWER_MODE_OFF) {
+        return;
+    }
+
+    const struct device *ext_power = ext_power_device();
+    if (ext_power != NULL) {
+        ext_power_enable(ext_power);
+        k_msleep(10);
+    }
+
+    force_refresh_display_cb(work);
+
+    if (display_power_mode == ZMK_DISPLAY_POWER_MODE_OPTIMAL) {
+        k_work_reschedule_for_queue(zmk_display_work_q(), &physically_power_off_display_work,
+                                    K_MSEC(display_show_timeout_ms));
+    } else {
+        k_work_cancel_delayable(&physically_power_off_display_work);
+    }
+}
+
+K_WORK_DEFINE(show_display_for_work, show_display_for_cb);
+
+void zmk_display_force_refresh(void) {
+    k_work_submit_to_queue(zmk_display_work_q(), &force_refresh_display_work);
+}
+
+void zmk_display_show_for_ms(uint32_t timeout_ms) {
+    display_show_timeout_ms = timeout_ms;
+    k_work_submit_to_queue(zmk_display_work_q(), &show_display_for_work);
+}
+
+void zmk_display_notify_for_ms(const char *line1, const char *line2, uint32_t timeout_ms,
+                               bool flash) {
+    snprintf(notification_text, sizeof(notification_text), "%s\n%s", line1, line2);
+    notification_timeout_ms = timeout_ms;
+    notification_flash = flash;
+    k_work_submit_to_queue(zmk_display_work_q(), &show_notification_work);
+}
+
+enum zmk_display_power_mode zmk_display_power_get_mode(void) { return display_power_mode; }
+
+static void set_display_power_mode_cb(struct k_work *work) {
+    display_power_mode = requested_display_power_mode;
+
+    switch (display_power_mode) {
+    case ZMK_DISPLAY_POWER_MODE_ON:
+        k_work_cancel_delayable(&physically_power_off_display_work);
+        zmk_display_notify_for_ms("Display Mode", "ON", 3000, false);
+        break;
+    case ZMK_DISPLAY_POWER_MODE_OFF:
+        k_work_cancel_delayable(&physically_power_off_display_work);
+        zmk_display_notify_for_ms("Display Mode", "OFF", 3000, false);
+        break;
+    case ZMK_DISPLAY_POWER_MODE_OPTIMAL:
+    default:
+        zmk_display_notify_for_ms("Display Mode", "OPTIMAL", 5000, false);
+        break;
+    }
+}
+
+K_WORK_DEFINE(set_display_power_mode_work, set_display_power_mode_cb);
+
+void zmk_display_power_set_mode(enum zmk_display_power_mode mode) {
+    requested_display_power_mode = mode;
+    k_work_submit_to_queue(zmk_display_work_q(), &set_display_power_mode_work);
+}
+
+void zmk_display_power_cycle_mode(void) {
+    switch (display_power_mode) {
+    case ZMK_DISPLAY_POWER_MODE_OPTIMAL:
+        zmk_display_power_set_mode(ZMK_DISPLAY_POWER_MODE_ON);
+        break;
+    case ZMK_DISPLAY_POWER_MODE_ON:
+        zmk_display_power_set_mode(ZMK_DISPLAY_POWER_MODE_OFF);
+        break;
+    case ZMK_DISPLAY_POWER_MODE_OFF:
+    default:
+        zmk_display_power_set_mode(ZMK_DISPLAY_POWER_MODE_OPTIMAL);
+        break;
+    }
+}
+
