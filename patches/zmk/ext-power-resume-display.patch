+#define RAW_NOTIFICATION_MAX_WIDTH 128
+#define RAW_NOTIFICATION_MAX_HEIGHT 32
+static uint8_t raw_notification_buf[RAW_NOTIFICATION_MAX_WIDTH * RAW_NOTIFICATION_MAX_HEIGHT / 8];
+
+static const uint8_t *glyph_5x7(char c) {
+    static const uint8_t blank[5] = {0, 0, 0, 0, 0};
+    static const uint8_t glyphs[][5] = {
+        {0x7e,0x11,0x11,0x11,0x7e}, /* A */ {0x7f,0x49,0x49,0x49,0x36}, /* B */
+        {0x3e,0x41,0x41,0x41,0x22}, /* C */ {0x7f,0x41,0x41,0x22,0x1c}, /* D */
+        {0x7f,0x49,0x49,0x49,0x41}, /* E */ {0x7f,0x09,0x09,0x09,0x01}, /* F */
+        {0x3e,0x41,0x49,0x49,0x7a}, /* G */ {0x7f,0x08,0x08,0x08,0x7f}, /* H */
+        {0x00,0x41,0x7f,0x41,0x00}, /* I */ {0x20,0x40,0x41,0x3f,0x01}, /* J */
+        {0x7f,0x08,0x14,0x22,0x41}, /* K */ {0x7f,0x40,0x40,0x40,0x40}, /* L */
+        {0x7f,0x02,0x0c,0x02,0x7f}, /* M */ {0x7f,0x04,0x08,0x10,0x7f}, /* N */
+        {0x3e,0x41,0x41,0x41,0x3e}, /* O */ {0x7f,0x09,0x09,0x09,0x06}, /* P */
+        {0x3e,0x41,0x51,0x21,0x5e}, /* Q */ {0x7f,0x09,0x19,0x29,0x46}, /* R */
+        {0x46,0x49,0x49,0x49,0x31}, /* S */ {0x01,0x01,0x7f,0x01,0x01}, /* T */
+        {0x3f,0x40,0x40,0x40,0x3f}, /* U */ {0x1f,0x20,0x40,0x20,0x1f}, /* V */
+        {0x7f,0x20,0x18,0x20,0x7f}, /* W */ {0x63,0x14,0x08,0x14,0x63}, /* X */
+        {0x07,0x08,0x70,0x08,0x07}, /* Y */ {0x61,0x51,0x49,0x45,0x43}, /* Z */
+    };
+    static const uint8_t digits[][5] = {
+        {0x3e,0x51,0x49,0x45,0x3e}, {0x00,0x42,0x7f,0x40,0x00},
+        {0x42,0x61,0x51,0x49,0x46}, {0x21,0x41,0x45,0x4b,0x31},
+        {0x18,0x14,0x12,0x7f,0x10}, {0x27,0x45,0x45,0x45,0x39},
+        {0x3c,0x4a,0x49,0x49,0x30}, {0x01,0x71,0x09,0x05,0x03},
+        {0x36,0x49,0x49,0x49,0x36}, {0x06,0x49,0x49,0x29,0x1e},
+    };
+    static const uint8_t percent[5] = {0x23,0x13,0x08,0x64,0x62};
+    static const uint8_t bang[5] = {0x00,0x00,0x5f,0x00,0x00};
+    static const uint8_t dash[5] = {0x08,0x08,0x08,0x08,0x08};
+
+    if (c >= 'a' && c <= 'z') {
+        c = c - 'a' + 'A';
+    }
+    if (c >= 'A' && c <= 'Z') {
+        return glyphs[c - 'A'];
+    }
+    if (c >= '0' && c <= '9') {
+        return digits[c - '0'];
+    }
+    if (c == '%') {
+        return percent;
+    }
+    if (c == '!') {
+        return bang;
+    }
+    if (c == '-') {
+        return dash;
+    }
+    return blank;
+}
+
+static void raw_set_pixel(const struct display_capabilities *caps, uint16_t width, uint16_t x,
+                          uint16_t y, bool on) {
+    if (x >= width || y >= RAW_NOTIFICATION_MAX_HEIGHT) {
+        return;
+    }
+
+    uint8_t *byte = &raw_notification_buf[x + (y / 8) * width];
+    uint8_t bit = (caps->screen_info & SCREEN_INFO_MONO_MSB_FIRST) ? (7 - (y % 8)) : (y % 8);
+
+    if (caps->current_pixel_format == PIXEL_FORMAT_MONO10) {
+        if (on) {
+            *byte |= BIT(bit);
+        } else {
+            *byte &= ~BIT(bit);
+        }
+    } else {
+        if (on) {
+            *byte &= ~BIT(bit);
+        } else {
+            *byte |= BIT(bit);
+        }
+    }
+}
+
+static void raw_draw_char(const struct display_capabilities *caps, uint16_t width, uint16_t x,
+                          uint16_t y, char c) {
+    const uint8_t *glyph = glyph_5x7(c);
+
+    for (uint8_t col = 0; col < 5; col++) {
+        for (uint8_t row = 0; row < 7; row++) {
+            if (glyph[col] & BIT(row)) {
+                raw_set_pixel(caps, width, x + col, y + row, true);
+            }
+        }
+    }
+}
+
+static size_t raw_text_len(const char *text) {
+    size_t len = 0;
+    while (text[len] != '\0') {
+        len++;
+    }
+    return len;
+}
+
+static void raw_draw_text_centered(const struct display_capabilities *caps, uint16_t width,
+                                   uint16_t y, const char *text) {
+    size_t len = raw_text_len(text);
+    uint16_t text_width = len == 0 ? 0 : (len * 6 - 1);
+    uint16_t x = text_width >= width ? 0 : (width - text_width) / 2;
+
+    for (size_t i = 0; i < len && x + 5 <= width; i++) {
+        raw_draw_char(caps, width, x, y, text[i]);
+        x += 6;
+    }
+}
+
+static int raw_draw_notification(void) {
+    struct display_capabilities caps;
+    display_get_capabilities(display, &caps);
+
+    if (!(caps.screen_info & SCREEN_INFO_MONO_VTILED) || caps.x_resolution > RAW_NOTIFICATION_MAX_WIDTH ||
+        caps.y_resolution > RAW_NOTIFICATION_MAX_HEIGHT || caps.y_resolution < 16) {
+        return -ENOTSUP;
+    }
+
+    uint16_t width = caps.x_resolution;
+    uint16_t height = caps.y_resolution;
+    size_t buf_size = width * height / 8;
+    memset(raw_notification_buf, caps.current_pixel_format == PIXEL_FORMAT_MONO10 ? 0x00 : 0xff,
+           buf_size);
+
+    raw_draw_text_centered(&caps, width, 7, notification_line1);
+    raw_draw_text_centered(&caps, width, 19, notification_line2);
+
+    struct display_buffer_descriptor desc = {
+        .buf_size = buf_size,
+        .width = width,
+        .pitch = width,
+        .height = height,
+        .frame_incomplete = false,
+    };
+
+    return display_write(display, 0, 0, &desc, raw_notification_buf);
+}
+
+static int raw_clear_notification(void) {
+    struct display_capabilities caps;
+    display_get_capabilities(display, &caps);
+
+    if (!(caps.screen_info & SCREEN_INFO_MONO_VTILED) || caps.x_resolution > RAW_NOTIFICATION_MAX_WIDTH ||
+        caps.y_resolution > RAW_NOTIFICATION_MAX_HEIGHT) {
+        return -ENOTSUP;
+    }
+
+    size_t buf_size = caps.x_resolution * caps.y_resolution / 8;
+    memset(raw_notification_buf, caps.current_pixel_format == PIXEL_FORMAT_MONO10 ? 0x00 : 0xff,
+           buf_size);
+
+    struct display_buffer_descriptor desc = {
+        .buf_size = buf_size,
+        .width = caps.x_resolution,
+        .pitch = caps.x_resolution,
+        .height = caps.y_resolution,
+        .frame_incomplete = false,
+    };
+
+    return display_write(display, 0, 0, &desc, raw_notification_buf);
+}
+
+static void flash_raw_notification_cb(struct k_work *work);
+static void clear_raw_notification_cb(struct k_work *work);
+K_WORK_DELAYABLE_DEFINE(flash_raw_notification_work, flash_raw_notification_cb);
+K_WORK_DELAYABLE_DEFINE(clear_raw_notification_work, clear_raw_notification_cb);
+
+static void show_raw_notification_cb(struct k_work *work) {
+    notification_active = true;
+
+#if !IS_ENABLED(CONFIG_ARCH_POSIX)
+    k_timer_stop(&display_timer);
+#endif
+    k_work_cancel(&display_tick_work);
+    k_work_cancel(&force_refresh_display_work);
+    k_work_cancel_delayable(&physically_power_off_display_work);
+    k_work_cancel_delayable(&clear_raw_notification_work);
+    k_work_cancel_delayable(&flash_raw_notification_work);
+
+    const struct device *ext_power = ext_power_device();
+    if (ext_power != NULL) {
+        ext_power_enable(ext_power);
+        k_msleep(10);
+    }
+
+    /* ext_power_enable() may queue zmk_display_force_refresh(); cancel it so LVGL does not
+     * immediately redraw the normal status screen over this raw notification.
+     */
+    k_work_cancel(&display_tick_work);
+    k_work_cancel(&force_refresh_display_work);
+
+    display_blanking_off(display);
+    notification_visible = true;
+
+    if (raw_draw_notification() < 0) {
+        notification_active = false;
+        if (display_power_mode == ZMK_DISPLAY_POWER_MODE_ON) {
+            force_refresh_display_cb(work);
+        }
+        return;
+    }
+
+    if (notification_flash) {
+        k_work_reschedule_for_queue(zmk_display_work_q(), &flash_raw_notification_work, K_MSEC(500));
+    }
+
+    k_work_reschedule_for_queue(zmk_display_work_q(), &clear_raw_notification_work,
+                                K_MSEC(notification_timeout_ms));
+}
+
+K_WORK_DEFINE(show_raw_notification_work, show_raw_notification_cb);
+
+static void flash_raw_notification_cb(struct k_work *work) {
+    if (!notification_active || !notification_flash) {
+        return;
+    }
+
+    notification_visible = !notification_visible;
+    if (notification_visible) {
+        raw_draw_notification();
+    } else {
+        raw_clear_notification();
+    }
+
+    k_work_reschedule_for_queue(zmk_display_work_q(), &flash_raw_notification_work, K_MSEC(500));
+}
+
+static void clear_raw_notification_cb(struct k_work *work) {
+    notification_active = false;
+    notification_flash = false;
+    k_work_cancel_delayable(&flash_raw_notification_work);
+
+    if (display_power_mode == ZMK_DISPLAY_POWER_MODE_ON) {
+        force_refresh_display_cb(work);
+    } else {
+        power_off_display_rail();
+    }
+}
+
+void zmk_display_notify_for_ms(const char *line1, const char *line2, uint32_t timeout_ms,
+                               bool flash) {
+    snprintf(notification_line1, sizeof(notification_line1), "%s", line1);
+    snprintf(notification_line2, sizeof(notification_line2), "%s", line2);
+    notification_timeout_ms = timeout_ms;
+    notification_flash = flash;
+    k_work_submit_to_queue(zmk_display_work_q(), &show_raw_notification_work);
+}
+
+static void show_display_for_cb(struct k_work *work) {
+    if (notification_active) {
+        return;
+    }
+
+    if (display_power_mode == ZMK_DISPLAY_POWER_MODE_OFF) {
+        return;
+    }
+
+    const struct device *ext_power = ext_power_device();
+    if (ext_power != NULL) {
+        ext_power_enable(ext_power);
+        k_msleep(10);
+    }
+
+    force_refresh_display_cb(work);
+
+    if (display_power_mode == ZMK_DISPLAY_POWER_MODE_OPTIMAL) {
+        k_work_reschedule_for_queue(zmk_display_work_q(), &physically_power_off_display_work,
+                                    K_MSEC(display_show_timeout_ms));
+    } else {
+        k_work_cancel_delayable(&physically_power_off_display_work);
+    }
+}
+
+K_WORK_DEFINE(show_display_for_work, show_display_for_cb);
+
+void zmk_display_force_refresh(void) {
+    k_work_submit_to_queue(zmk_display_work_q(), &force_refresh_display_work);
+}
+
+void zmk_display_show_for_ms(uint32_t timeout_ms) {
+    display_show_timeout_ms = timeout_ms;
+    k_work_submit_to_queue(zmk_display_work_q(), &show_display_for_work);
+}
+
+enum zmk_display_power_mode zmk_display_power_get_mode(void) { return display_power_mode; }
+
+static void set_display_power_mode_cb(struct k_work *work) {
+    display_power_mode = requested_display_power_mode;
+
+    switch (display_power_mode) {
+    case ZMK_DISPLAY_POWER_MODE_ON:
+        zmk_display_notify_for_ms("DISPLAY MODE", "ON", 2000, false);
+        break;
+    case ZMK_DISPLAY_POWER_MODE_OFF:
+        zmk_display_notify_for_ms("DISPLAY MODE", "OFF", 2000, false);
+        break;
+    case ZMK_DISPLAY_POWER_MODE_OPTIMAL:
+    default:
+        zmk_display_notify_for_ms("DISPLAY MODE", "OPTIMAL", 2500, false);
+        break;
+    }
+}
+
+K_WORK_DEFINE(set_display_power_mode_work, set_display_power_mode_cb);
+
+void zmk_display_power_set_mode(enum zmk_display_power_mode mode) {
+    requested_display_power_mode = mode;
+    k_work_submit_to_queue(zmk_display_work_q(), &set_display_power_mode_work);
+}
+
+void zmk_display_power_cycle_mode(void) {
+    switch (display_power_mode) {
+    case ZMK_DISPLAY_POWER_MODE_OPTIMAL:
+        zmk_display_power_set_mode(ZMK_DISPLAY_POWER_MODE_ON);
+        break;
+    case ZMK_DISPLAY_POWER_MODE_ON:
+        zmk_display_power_set_mode(ZMK_DISPLAY_POWER_MODE_OFF);
+        break;
+    case ZMK_DISPLAY_POWER_MODE_OFF:
+    default:
+        zmk_display_power_set_mode(ZMK_DISPLAY_POWER_MODE_OPTIMAL);
+        break;
+    }
+}
